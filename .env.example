# Finora environment configuration
# Copy this file to .env and adjust the values.

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Database (production/default)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=finora

# Optional development fallback for automated tests on machines without MySQL.
# Keep DB_ENGINE=mysql for the delivered application.
# DB_ENGINE=sqlite
# SQLITE_PATH=backend/finora.sqlite3
